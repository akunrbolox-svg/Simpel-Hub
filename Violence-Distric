closeHub = function(instant)
    if closed then
        return
    end
    closed = true
    for _, key in ipairs(ORDER) do
        if type(DEFAULTS[key]) == "boolean" and Hub.State[key] then
            Hub.State[key] = false
            local list = refreshers[key]
            if list then
                for _, fn in ipairs(list) do
                    pcall(fn, false)
                end
            end
            fire(key, false)
        end
    end
    local function finish()
        for _, c in ipairs(connections) do
            pcall(function()
                c:Disconnect()
            end)
        end
        connections = {}
        pcall(function()
            screenGui:Destroy()
        end)
        if ENV.SimpelHub == Hub then
            ENV.SimpelHub = nil
        end
        if ENV.SimpelHubCleanup == Hub.Cleanup then
            ENV.SimpelHubCleanup = nil
        end
    end
    if not instant and win.Visible then
        local sz = winSize()
        tween(win, 0.15, { Size = UDim2.fromOffset(sz.X, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.16, finish)
    else
        finish()
    end
end

