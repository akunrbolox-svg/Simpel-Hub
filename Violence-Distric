local function writeData(name, data)
    Mem[name] = data
    if type(writefile) == "function" then
        local ok = pcall(writefile, name, data)
        if ok then
            return "file"
        end
    end
    return "memory"
end

local function readData(name)
    if type(readfile) == "function" and type(isfile) == "function" then
        local okExists, exists = pcall(isfile, name)
        if okExists and exists then
            local okRead, content = pcall(readfile, name)
            if okRead and type(content) == "string" and content ~= "" then
                return content
            end
            return nil
        end
    end
    local m = Mem[name]
    if type(m) == "string" and m ~= "" then
        return m
    end
    return nil
end

local function clamp(x, lo, hi)
    if x < lo then
        return lo
    elseif x > hi then
        return hi
    end
    return x
end

local function snap(n, lo, step)
    local r = lo + math.floor((n - lo) / step + 0.5) * step
    return math.floor(r * 10000 + 0.5) / 10000
end

local function toByte(x)
    return clamp(math.floor(x * 255 + 0.5), 0, 255)
end

