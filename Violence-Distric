    local function step(dir, silent)
        local before = Hub.State[key]
        setState(key, before + dir * lim[3])
        if not silent then
            playSound(Hub.State[key] ~= before and "click" or "off")
        end
    end
    local holdToken = 0
    local function startHold(dir, btn)
        holdToken = holdToken + 1
        local my = holdToken
        step(dir, false)
        task.spawn(function()
            task.wait(0.4)
            while holdToken == my and btn.Parent do
                step(dir, true)
                task.wait(0.07)
            end
        end)
    end
    local function stopHold()
        holdToken = holdToken + 1
    end
    minus.MouseButton1Down:Connect(function()
        startHold(-1, minus)
    end)
    plus.MouseButton1Down:Connect(function()
        startHold(1, plus)
    end)
    minus.MouseButton1Up:Connect(stopHold)
    plus.MouseButton1Up:Connect(stopHold)
    minus.MouseLeave:Connect(stopHold)
    plus.MouseLeave:Connect(stopHold)
end

