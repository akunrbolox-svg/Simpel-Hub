local function playSound(kind)
    local snd = nil
    for _, s in ipairs(clickSounds) do
        if s.IsLoaded and s.TimeLength > 0 then
            snd = s
            break
        end
    end
    snd = snd or clickSounds[1]
    if not snd then
        return
    end
    pcall(function()
        if kind == "on" then
            snd.PlaybackSpeed = 1.15
        elseif kind == "off" then
            snd.PlaybackSpeed = 0.88
        else
            snd.PlaybackSpeed = 0.97 + math.random() * 0.08
        end
        snd.TimePosition = 0
        snd:Play()
    end)
end

