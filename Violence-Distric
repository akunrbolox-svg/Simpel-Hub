        Position = UDim2.new(0, 177, 0, 324),
        Size = UDim2.new(0, 150, 0, 46),
        BackgroundColor3 = Color3.fromRGB(150, 150, 150),
        BorderSizePixel = 0,
        Text = "Apply",
        TextColor3 = TEXT,
        Font = FONT_BOLD,
        TextSize = 16,
        AutoButtonColor = false,
    }, panel)
    corner(applyBtn, 23)

    local function refresh(source)
        local color = Color3.fromHSV(h, s, v)
        local r, g, b = toByte(color.R), toByte(color.G), toByte(color.B)
        swatch.BackgroundColor3 = color
        svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(0.5, 0, h, 0)
        if source ~= "hex" then
            hexBox.Text = string.format("#%02X%02X%02X", r, g, b)
        end
        if source ~= "rgb" then
            rBox.Text = tostring(r)
            gBox.Text = tostring(g)
            bBox.Text = tostring(b)
        end
        if r == baseR and g == baseG and b == baseB then
            applyBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
            applyBtn.TextColor3 = TEXT
        else
            applyBtn.BackgroundColor3 = ACCENT
            applyBtn.TextColor3 = DARK_TEXT
        end
    end

    local function setFromColor(color, source)
        local nh, ns, nv = color:ToHSV()
        if ns > 0.001 and nv > 0.001 then
            h = nh
        end
        s, v = ns, nv
        refresh(source)
    end

    local function updateSV(pos)
        local ap = svFrame.AbsolutePosition
        local as = svFrame.AbsoluteSize
        if as.X <= 0 or as.Y <= 0 then
            return
        end
        s = clamp((pos.X - ap.X) / as.X, 0, 1)
        v = 1 - clamp((pos.Y - ap.Y) / as.Y, 0, 1)
        refresh(nil)
    end

    local function updateHue(pos)
        local ap = hueFrame.AbsolutePosition
        local as = hueFrame.AbsoluteSize
        if as.Y <= 0 then
            return
        end
        h = clamp((pos.Y - ap.Y) / as.Y, 0, 1)
        refresh(nil)
    end

    svHit.InputBegan:Connect(function(input)
        if isPointer(input) then
            dragMode = "sv"
            updateSV(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    hueHit.InputBegan:Connect(function(input)
        if isPointer(input) then
            dragMode = "hue"
            updateHue(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if not dragMode then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local p = Vector2.new(input.Position.X, input.Position.Y)
            if dragMode == "sv" then
                updateSV(p)
            elseif dragMode == "hue" then
                updateHue(p)
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if isPointer(input) then
            dragMode = nil
        end
    end))

    hexBox.FocusLost:Connect(function()
        local txt = tostring(hexBox.Text or "")
        txt = txt:gsub("#", "")
        txt = txt:gsub("%s", "")
        if #txt == 3 and txt:match("^%x%x%x$") then
            txt = txt:sub(1, 1):rep(2) .. txt:sub(2, 2):rep(2) .. txt:sub(3, 3):rep(2)
        end
        if #txt == 6 and txt:match("^%x%x%x%x%x%x$") then
            local r = tonumber(txt:sub(1, 2), 16)
            local g = tonumber(txt:sub(3, 4), 16)
            local b = tonumber(txt:sub(5, 6), 16)
            setFromColor(Color3.fromRGB(r, g, b), "hex")
            hexBox.Text = "#" .. txt:upper()
        else
            refresh(nil)
        end
    end)

    local function readChannel(box)
        local n = tonumber(box.Text)
        if not n then
            return nil
        end
        return clamp(math.floor(n), 0, 255)
    end

    local function onRgbCommit()
        local r, g, b = readChannel(rBox), readChannel(gBox), readChannel(bBox)
        if r and g and b then
            setFromColor(Color3.fromRGB(r, g, b), "rgb")
            rBox.Text, gBox.Text, bBox.Text = tostring(r), tostring(g), tostring(b)
            hexBox.Text = string.format("#%02X%02X%02X", r, g, b)
        else
            refresh(nil)
        end
    end

    rBox.FocusLost:Connect(onRgbCommit)
    gBox.FocusLost:Connect(onRgbCommit)
    bBox.FocusLost:Connect(onRgbCommit)

    function P.updateScale()
        local vp = viewport()
        pscale.Scale = math.min(1, (vp.Y - 12) / 382, (vp.X - 12) / 340)
    end

    function P.close()
        dragMode = nil
        overlay.Visible = false
    end

    function P.open(key, label)
        currentKey = key
        titleLbl.Text = "Warna  -  " .. label
        local c = Hub.Colors[key]
        baseR, baseG, baseB = toByte(c.R), toByte(c.G), toByte(c.B)
        local nh, ns, nv = c:ToHSV()
        h, s, v = nh, ns, nv
        refresh(nil)
        P.updateScale()
        local target = pscale.Scale
        pscale.Scale = target * 0.92
        overlay.BackgroundTransparency = 1
        overlay.Visible = true
        tween(overlay, 0.18, { BackgroundTransparency = 0.45 })
        tween(pscale, 0.2, { Scale = target }, Enum.EasingStyle.Back)
    end

    applyBtn.MouseButton1Click:Connect(function()
        local color = Color3.fromHSV(h, s, v)
        local r, g, b = toByte(color.R), toByte(color.G), toByte(color.B)
        if r == baseR and g == baseG and b == baseB then
            return
        end
        playSound("on")
        if currentKey then
            setColor(currentKey, Color3.fromRGB(r, g, b))
        end
        baseR, baseG, baseB = r, g, b
        refresh(nil)
    end)

    cancelBtn.MouseButton1Click:Connect(function()
        playSound("off")
        P.close()
    end)

    P.updateScale()
    return P
end

