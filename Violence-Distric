local refreshers = {}
local colorRefreshers = {}

local function normalize(key, value)
    local default = DEFAULTS[key]
    if default == nil then
        return nil
    end
    if type(default) == "boolean" then
        return value == true
    elseif type(default) == "number" then
        local n = tonumber(value)
        if not n then
            return nil
        end
        local lim = LIMITS[key]
        if lim then
            n = clamp(n, lim[1], lim[2])
            n = snap(n, lim[1], lim[3])
        end
        return n
    elseif type(default) == "string" then
        local opts = OPTIONS[key]
        if opts then
            for _, o in ipairs(opts) do
                if o == value then
                    return value
                end
            end
        end
        return nil
    end
    return nil
end

local function fire(key, value)
    local list = Hub.Hooks[key]
    if not list then
        return
    end
    for _, fn in ipairs(list) do
        task.spawn(fn, value)
    end
end

local function setState(key, value)
    local nv = normalize(key, value)
    if nv == nil then
        return
    end
    if Hub.State[key] == nv then
        return
    end
    Hub.State[key] = nv
    local list = refreshers[key]
    if list then
        for _, fn in ipairs(list) do
            pcall(fn, nv)
        end
    end
    fire(key, nv)
end

local function setColor(key, color)
    if COLOR_DEFAULTS[key] == nil then
        return
    end
    Hub.Colors[key] = color
    local list = colorRefreshers[key]
    if list then
        for _, fn in ipairs(list) do
            pcall(fn, color)
        end
    end
    local hooks = Hub.ColorHooks[key]
    if hooks then
        for _, fn in ipairs(hooks) do
            task.spawn(fn, color)
        end
    end
end

local function register(key, fn)
    refreshers[key] = refreshers[key] or {}
    table.insert(refreshers[key], fn)
    fn(Hub.State[key], true)
    return fn
end

local function unregister(key, fn)
    local list = refreshers[key]
    if not list then
        return
    end
    for i, f in ipairs(list) do
        if f == fn then
            table.remove(list, i)
            break
        end
    end
end

function Hub.Get(key)
    return Hub.State[key]
end

function Hub.Set(key, value)
    setState(key, value)
end

function Hub.OnChange(key, fn)
    Hub.Hooks[key] = Hub.Hooks[key] or {}
    table.insert(Hub.Hooks[key], fn)
end

function Hub.GetColor(key)
    return Hub.Colors[key]
end

function Hub.OnColor(key, fn)
    Hub.ColorHooks[key] = Hub.ColorHooks[key] or {}
    table.insert(Hub.ColorHooks[key], fn)
end

local FX = {}
FX.Shared = ENV.SimpelHubShared
if type(FX.Shared) ~= "table" then
    FX.Shared = { installed = false, fn = nil }
    ENV.SimpelHubShared = FX.Shared
end
FX.handlers = {}
FX.killerCache = setmetatable({}, { __mode = "k" })

function FX.addHandler(fn)
    FX.handlers[#FX.handlers + 1] = fn
    return fn
end

function FX.removeHandler(fn)
    for i = #FX.handlers, 1, -1 do
        if FX.handlers[i] == fn then
            table.remove(FX.handlers, i)
        end
    end
end

function FX.dispatch(self, ...)
    local list = FX.handlers
    for i = 1, #list do
        local res = list[i](self, ...)
        if res then
            return res
        end
    end
    return nil
end

function FX.disconnectAll(list)
    for i = 1, #list do
        local c = list[i]
        pcall(function()
            c:Disconnect()
        end)
    end
    for i = #list, 1, -1 do
        list[i] = nil
    end
end

function FX.installHook()
    local S = FX.Shared
    S.fn = FX.dispatch
    if S.installed then
        return true
    end
    if not getnamecallmethod then
        return false
    end
    if not (hookmetamethod or getrawmetatable) then
        return false
    end
    local old
    local function handler(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" then
            local mine = false
            if checkcaller then
                mine = checkcaller()
            end
            local fn = S.fn
            if fn and not mine then
                local ok, res = pcall(fn, self, ...)
                if setnamecallmethod then
                    pcall(setnamecallmethod, method)
                end
                if ok and type(res) == "table" then
                    return old(self, table.unpack(res, 1, res.n))
                end
            end
        end
        return old(self, ...)
    end
    local wrapped = handler
    if newcclosure then
        local okW, w = pcall(newcclosure, handler)
        if okW and w then
            wrapped = w
        end
    end
    if hookmetamethod then
        local okH, prev = pcall(hookmetamethod, game, "__namecall", wrapped)
        if okH and prev then
            old = prev
            S.installed = true
            return true
        end
    end
    if getrawmetatable then
        local okM = pcall(function()
            local mt = getrawmetatable(game)
            local prev = mt.__namecall
            if setreadonly then
                setreadonly(mt, false)
            elseif make_writeable then
                make_writeable(mt)
            end
            old = prev
            mt.__namecall = wrapped
        end)
        if okM and old then
            S.installed = true
            return true
        end
    end
    return false
end

function FX.isKillerChar(char, now)
    if not char then
        return false
    end
    local c = FX.killerCache[char]
    if c then
        if c.k then
            return true
        end
        if now - c.t < 2 then
            return false
        end
    end
    local found = char:FindFirstChild("Lookscriptkiller", true) ~= nil
    FX.killerCache[char] = { k = found, t = now }
    return found
end

function FX.isKillerPlayer(p, now)
    if not p then
        return false
    end
    local ok, res = pcall(function()
        if p:GetAttribute("Role") == "Killer" or p:GetAttribute("IsKiller") == true then
            return true
        end
        if p.Team and string.find(string.lower(p.Team.Name), "killer", 1, true) then
            return true
        end
        return false
    end)
    if ok and res then
        return true
    end
    return FX.isKillerChar(p.Character, now)
end

do
    local Lighting = game:GetService("Lighting")
    local Workspace = game:GetService("Workspace")
    local SKY_NAME = "SimpelHubLightSky"
    local FACES = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
    local SKY_TEX = {
        SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex",
        SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex",
        SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex",
        SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex",
        SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex",
        SkyboxUp = "rbxasset://textures/sky/sky512_up.tex",
    }
    local BRIGHT = {
        Brightness = 2,
        ClockTime = 14,
        ExposureCompensation = 0,
        FogStart = 100000,
        FogEnd = 100000,
        Ambient = Color3.fromRGB(170, 170, 170),
        OutdoorAmbient = Color3.fromRGB(170, 170, 170),
    }
    local active = false
    local tracked = {}
    local conns = {}
    local origLighting = {}
    local origAtmo = {}
    local ownSky = nil
    local hbConn = nil
    local elapsed = 0
    local enforcing = false

    local function enforce(sky)
        if enforcing then
            return
        end
        enforcing = true
        for _, face in ipairs(FACES) do
            pcall(function()
                if sky[face] ~= SKY_TEX[face] then
                    sky[face] = SKY_TEX[face]
                end
            end)
        end
        pcall(function()
            if sky.CelestialBodiesShown ~= false then
                sky.CelestialBodiesShown = false
            end
            if sky.StarCount ~= 0 then
                sky.StarCount = 0
            end
        end)
        enforcing = false
    end

    local function enforceLighting()
        for prop, val in pairs(BRIGHT) do
            pcall(function()
                if Lighting[prop] ~= val then
                    Lighting[prop] = val
                end
            end)
        end
        pcall(function()
            for _, inst in ipairs(Lighting:GetChildren()) do
                if inst:IsA("Atmosphere") then
                    if not origAtmo[inst] then
                        origAtmo[inst] = { Density = inst.Density, Haze = inst.Haze, Glare = inst.Glare }
                    end
                    if inst.Density ~= 0 then
                        inst.Density = 0
                    end
                    if inst.Haze ~= 0 then
                        inst.Haze = 0
                    end
                    if inst.Glare ~= 0 then
                        inst.Glare = 0
                    end
                end
            end
        end)
    end

    local function untrack(sky)
        local rec = tracked[sky]
        if rec then
            for _, c in ipairs(rec.conns) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            tracked[sky] = nil
        end
    end

    local function track(sky)
        if not active or tracked[sky] then
            return
        end
        local rec = { conns = {}, orig = {} }
        tracked[sky] = rec
        for _, face in ipairs(FACES) do
            local okp, v = pcall(function()
                return sky[face]
            end)
            if okp then
                rec.orig[face] = v
            end
        end
        pcall(function()
            rec.orig.CelestialBodiesShown = sky.CelestialBodiesShown
            rec.orig.StarCount = sky.StarCount
        end)
        enforce(sky)
        for _, face in ipairs(FACES) do
            local ok, sig = pcall(function()
                return sky:GetPropertyChangedSignal(face)
            end)
            if ok and sig then
                table.insert(rec.conns, sig:Connect(function()
                    enforce(sky)
                end))
            end
        end
        table.insert(rec.conns, sky.AncestryChanged:Connect(function()
            if not sky:IsDescendantOf(game) then
                untrack(sky)
            end
        end))
    end

    local function ensureOwnSky()
        if not active then
            return
        end
        if ownSky == nil or ownSky.Parent ~= Lighting then
            if ownSky then
                untrack(ownSky)
                ownSky = nil
            end
            local existing = Lighting:FindFirstChild(SKY_NAME)
            if existing and existing:IsA("Sky") then
                ownSky = existing
            else
                local s = Instance.new("Sky")
                s.Name = SKY_NAME
                pcall(function()
                    s.Parent = Lighting
                end)
                if s.Parent == Lighting then
                    ownSky = s
                end
            end
        end
        if ownSky then
            track(ownSky)
        end
    end

    local function scan(root)
        local ok, list = pcall(function()
            return root:GetDescendants()
        end)
        if ok and list then
            for _, inst in ipairs(list) do
                if inst:IsA("Sky") then
                    track(inst)
                end
            end
        end
    end

    local function start()
        if active then
            return
        end
        active = true
        origLighting = {}
        origAtmo = {}
        for prop in pairs(BRIGHT) do
            pcall(function()
                origLighting[prop] = Lighting[prop]
            end)
        end
        ensureOwnSky()
        scan(Lighting)
        scan(Workspace)
        enforceLighting()
        table.insert(conns, Lighting.DescendantAdded:Connect(function(inst)
            if inst:IsA("Sky") then
                track(inst)
            end
        end))
        table.insert(conns, Workspace.DescendantAdded:Connect(function(inst)
            if inst:IsA("Sky") then
                track(inst)
            end
        end))
        table.insert(conns, Lighting.ChildRemoved:Connect(function()
            ensureOwnSky()
        end))
        elapsed = 0
        hbConn = RunService.Heartbeat:Connect(function(dt)
            if not active then
                return
            end
            pcall(function()
                ensureOwnSky()
                for sky in pairs(tracked) do
                    enforce(sky)
                end
                enforceLighting()
                elapsed = elapsed + dt
                if elapsed >= 2 then
                    elapsed = 0
                    scan(Lighting)
                end
            end)
        end)
    end

    local function stop()
        if not active then
            return
        end
        active = false
        if hbConn then
            pcall(function()
                hbConn:Disconnect()
            end)
            hbConn = nil
        end
        FX.disconnectAll(conns)
        for sky, rec in pairs(tracked) do
            for _, c in ipairs(rec.conns) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            if sky ~= ownSky and sky.Parent then
                for prop, v in pairs(rec.orig) do
                    pcall(function()
                        sky[prop] = v
                    end)
                end
            end
            tracked[sky] = nil
        end
        for prop, v in pairs(origLighting) do
            pcall(function()
                Lighting[prop] = v
            end)
        end
        for inst, o in pairs(origAtmo) do
            if inst.Parent then
                pcall(function()
                    inst.Density = o.Density
                    inst.Haze = o.Haze
                    inst.Glare = o.Glare
                end)
            end
        end
        origAtmo = {}
        if ownSky then
            pcall(function()
                ownSky:Destroy()
            end)
            ownSky = nil
        end
    end

    Hub.OnChange("LightWorld", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

do
    local Workspace = game:GetService("Workspace")
    local BIND = "SimpelHubFovLock"
    local MIN_FOV, MAX_FOV = 70, 120
    local active = false
    local token = 0
    local origFov = nil
    local conns = {}
    local camConn = nil

    local function levelToFov(level)
        level = tonumber(level) or 5
        if level < 1 then
            level = 1
        end
        if level > 10 then
            level = 10
        end
        return MIN_FOV + ((level - 1) / 9) * (MAX_FOV - MIN_FOV)
    end

    local function applyFov()
        if not active then
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then
            return
        end
        if origFov == nil then
            origFov = cam.FieldOfView
        end
        local target = levelToFov(Hub.State.LockFovLevel)
        if cam.FieldOfView ~= target then
            cam.FieldOfView = target
        end
    end

    local function hookCam()
        if camConn then
            pcall(function()
                camConn:Disconnect()
            end)
            camConn = nil
        end
        local cam = Workspace.CurrentCamera
        if cam then
            camConn = cam:GetPropertyChangedSignal("FieldOfView"):Connect(applyFov)
            applyFov()
        end
    end

    local function start()
        if active then
            return
        end
        active = true
        token = token + 1
        local my = token
        origFov = nil
        pcall(function()
            RunService:UnbindFromRenderStep(BIND)
        end)
        pcall(function()
            RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1, applyFov)
        end)
        table.insert(conns, RunService.RenderStepped:Connect(applyFov))
        table.insert(conns, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCam))
        table.insert(conns, player.CharacterAdded:Connect(function()
            task.wait()
            hookCam()
        end))
        hookCam()
        task.spawn(function()
            while active and token == my do
                task.wait(1.5)
                if not (active and token == my) then
                    break
                end
                hookCam()
            end
        end)
    end

    local function stop()
        if not active then
            return
        end
        active = false
        token = token + 1
        pcall(function()
            RunService:UnbindFromRenderStep(BIND)
        end)
        FX.disconnectAll(conns)
        if camConn then
            pcall(function()
                camConn:Disconnect()
            end)
            camConn = nil
        end
        local cam = Workspace.CurrentCamera
        if cam and origFov then
            pcall(function()
                cam.FieldOfView = origFov
            end)
        end
        origFov = nil
    end

    Hub.OnChange("LockFov", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

do
    local Workspace = game:GetService("Workspace")
    local BIND = "SimpelHubCamStiff"
    local active = false
    local camera = nil
    local smoothedPos = nil
    local ready = false
    local gen = 0
    local conns = {}

    local function getAlpha(level)
        level = tonumber(level) or 5
        return 0.06 + ((level - 1) / 9) * 0.39
    end

    local function initChar(char)
        ready = false
        smoothedPos = nil
        gen = gen + 1
        local my = gen
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if not hrp or not active or gen ~= my then
            return
        end
        RunService.RenderStepped:Wait()
        if not active or gen ~= my then
            return
        end
        camera = Workspace.CurrentCamera
        if camera then
            smoothedPos = camera.CFrame.Position
            ready = true
        end
    end

    local function step(dt)
        if not active or not ready then
            return
        end
        if not camera or not camera.Parent then
            camera = Workspace.CurrentCamera
            return
        end
        local targetCF = camera.CFrame
        if smoothedPos == nil then
            smoothedPos = targetCF.Position
            return
        end
        local targetPos = targetCF.Position
        local targetRot = targetCF - targetPos
        local baseAlpha = getAlpha(Hub.State.CameraStiffnessLevel)
        local alpha = 1 - (1 - baseAlpha) ^ (dt * 60)
        smoothedPos = smoothedPos:Lerp(targetPos, alpha)
        camera.CFrame = CFrame.new(smoothedPos) * targetRot
    end

    local function start()
        if active then
            return
        end
        active = true
        ready = false
        smoothedPos = nil
        camera = Workspace.CurrentCamera
        pcall(function()
            RunService:UnbindFromRenderStep(BIND)
        end)
        pcall(function()
            RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1, step)
        end)
        table.insert(conns, player.CharacterAdded:Connect(function(char)
            task.spawn(initChar, char)
        end))
        table.insert(conns, player.CharacterRemoving:Connect(function()
            ready = false
            smoothedPos = nil
        end))
        table.insert(conns, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            camera = Workspace.CurrentCamera
            smoothedPos = nil
            ready = false
            if player.Character then
                task.spawn(initChar, player.Character)
            end
        end))
        if player.Character then
            task.spawn(initChar, player.Character)
        end
    end

    local function stop()
        if not active then
            return
        end
        active = false
        ready = false
