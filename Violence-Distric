do
    local active = false
    local conn = nil
    local charConn = nil
    local st = nil

    local function restore()
        local s = st
        st = nil
        if s and s.hum and s.hum.Parent and s.add > 0 then
            pcall(function()
                s.hum.WalkSpeed = s.base
            end)
        end
    end

    local function monitor(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum or not active then
            return
        end
        if conn then
            pcall(function()
                conn:Disconnect()
            end)
            conn = nil
        end
        local mine = { hum = hum, base = hum.WalkSpeed, add = 0 }
        st = mine
        conn = RunService.Heartbeat:Connect(function()
            if not active or not hum.Parent then
                return
            end
            local s = hum:GetState()
            local amount = Hub.State.SpeedAmount
            if s == Enum.HumanoidStateType.Climbing
                or s == Enum.HumanoidStateType.Jumping
                or s == Enum.HumanoidStateType.FallingDown
                or s == Enum.HumanoidStateType.Ragdoll then
                if mine.add > 0 then
                    hum.WalkSpeed = mine.base
                    mine.add = 0
                end
                return
            end
            local currentWS = hum.WalkSpeed
            if currentWS == (mine.base + mine.add) then
                if amount ~= mine.add then
                    mine.add = amount
                    if mine.base >= 10.10 then
                        hum.WalkSpeed = mine.base + amount
                    end
                end
            else
                if currentWS >= 10.10 then
                    mine.base = currentWS
                    mine.add = amount
                    hum.WalkSpeed = currentWS + amount
                else
                    mine.base = currentWS
                    mine.add = 0
                end
            end
        end)
    end

    local function start()
        if active then
            return
        end
        active = true
        local char = player.Character
        if char then
            task.spawn(monitor, char)
        end
        charConn = player.CharacterAdded:Connect(function(c)
            task.wait(1)
            if active then
                monitor(c)
            end
        end)
    end

    local function stop()
        if not active then
            return
        end
        active = false
        if conn then
            pcall(function()
                conn:Disconnect()
            end)
            conn = nil
        end
        if charConn then
            pcall(function()
                charConn:Disconnect()
            end)
            charConn = nil
        end
        restore()
    end

    Hub.OnChange("SpeedBoost", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

do
    local survOn, killOn = false, false
    local looping = false
    local loopToken = 0
    local survHL = {}
    local killHL = {}

    local function makeHL(char, name, colorKey, fillTransparency)
        local hl = Instance.new("Highlight")
        hl.Name = name
        local c = Hub.Colors[colorKey]
        hl.FillColor = c
        hl.OutlineColor = c
        hl.FillTransparency = fillTransparency
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char
        hl.Parent = char
        return hl
    end

    local function destroyMap(map)
        for char, hl in pairs(map) do
            pcall(function()
                hl:Destroy()
            end)
            map[char] = nil
        end
    end

    local function reconcile()
        local now = os.clock()
        local seenS, seenK = {}, {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                if char and char.Parent then
                    if FX.isKillerPlayer(p, now) then
                        if killOn then
                            seenK[char] = true
                            local hl = killHL[char]
                            if not (hl and hl.Parent) then
                                killHL[char] = makeHL(char, "SimpelKillerEsp", "KillerEsp", 0.65)
                            end
                        end
                    else
                        if survOn then
                            seenS[char] = true
                            local hl = survHL[char]
                            if not (hl and hl.Parent) then
                                survHL[char] = makeHL(char, "SimpelSurvivorEsp", "SurvivorEsp", 0.75)
                            end
                        end
                    end
                end
            end
        end
        for char, hl in pairs(survHL) do
            if not seenS[char] then
                pcall(function()
                    hl:Destroy()
                end)
                survHL[char] = nil
            end
        end
        for char, hl in pairs(killHL) do
            if not seenK[char] then
                pcall(function()
                    hl:Destroy()
                end)
                killHL[char] = nil
            end
        end
    end

    local function refresh()
        local need = survOn or killOn
        if need and not looping then
            looping = true
            loopToken = loopToken + 1
            local my = loopToken
            task.spawn(function()
                while looping and loopToken == my do
                    pcall(reconcile)
                    task.wait(0.4)
                end
            end)
        elseif not need and looping then
            looping = false
            loopToken = loopToken + 1
            destroyMap(survHL)
            destroyMap(killHL)
        end
    end

    Hub.OnChange("SurvivorEsp", function(on)
        survOn = on
        if not on then
            destroyMap(survHL)
        end
        refresh()
    end)

    Hub.OnChange("KillerEsp", function(on)
        killOn = on
        if not on then
            destroyMap(killHL)
        end
        refresh()
    end)

    Hub.OnColor("SurvivorEsp", function(c)
        for _, hl in pairs(survHL) do
            pcall(function()
                hl.FillColor = c
                hl.OutlineColor = c
            end)
        end
    end)

    Hub.OnColor("KillerEsp", function(c)
        for _, hl in pairs(killHL) do
            pcall(function()
                hl.FillColor = c
                hl.OutlineColor = c
            end)
        end
    end)
end

do
    local Workspace = game:GetService("Workspace")
    local active = false
    local token = 0
    local gens = {}
    local conns = {}
    local BG_COLOR = Color3.fromRGB(15, 15, 15)
    local BORDER_COLOR = Color3.fromRGB(60, 60, 60)
    local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
    local COLOR_START = Color3.fromRGB(235, 94, 40)
    local COLOR_MID = Color3.fromRGB(247, 197, 65)
    local COLOR_END = Color3.fromRGB(38, 194, 129)

    local function getSmoothColor(p)
        if p < 0.5 then
            return COLOR_START:Lerp(COLOR_MID, p * 2)
        else
            return COLOR_MID:Lerp(COLOR_END, (p - 0.5) * 2)
        end
    end

    local function getGenProgress(generator)
        local val = generator:FindFirstChild("Progress", true)
            or generator:FindFirstChild("Repair", true)
            or generator:FindFirstChild("Charge", true)
        if val and (val:IsA("NumberValue") or val:IsA("IntValue")) then
            return math.clamp(val.Value, 0, 100)
        end
        local prompt = generator:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.HoldDuration > 0 then
            local current = prompt:GetAttribute("CurrentTime")
            if current then
                return math.floor((current / prompt.HoldDuration) * 100)
            end
        end
        local attr = generator:GetAttribute("Progress")
            or generator:GetAttribute("Repair")
            or generator:GetAttribute("RepairProgress")
        if attr then
            return math.clamp(math.floor(attr), 0, 100)
        end
        return nil
    end

    local function isGenModel(obj)
        if not obj:IsA("Model") then
            return false
        end
        local lower = string.lower(obj.Name)
        if not string.find(lower, "gen", 1, true) then
            return false
        end
        if obj:FindFirstChildOfClass("Humanoid") then
            return false
        end
        local anc = obj.Parent
        while anc and anc ~= Workspace do
            if gens[anc] then
                return false
            end
            anc = anc.Parent
        end
        return true
    end

    local function runProgress(obj, rec, my)
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Linear)
        local finished = false
        while active and token == my and gens[obj] == rec and obj.Parent and not finished do
            local part = rec.bb.Adornee
            if not (part and part.Parent) then
                rec.bb.Adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            end
            local progress = getGenProgress(obj) or 0
            local clampedProgress = math.clamp(progress, 0, 100)
            local percentage = clampedProgress / 100
            if clampedProgress >= 100 then
                finished = true
                rec.bar.BackgroundColor3 = COLOR_END
                rec.label.Text = "100%"
                TweenService:Create(rec.bar, tweenInfo, { Size = UDim2.new(1, 0, 1, 0) }):Play()
                task.wait(0.3)
                rec.frame.Visible = false
                rec.hl.Enabled = false
            else
                rec.frame.Visible = true
                rec.hl.Enabled = true
                rec.label.Text = string.format("%d%%", math.floor(clampedProgress))
                TweenService:Create(rec.bar, tweenInfo, {
                    Size = UDim2.new(percentage, 0, 1, 0),
                    BackgroundColor3 = getSmoothColor(percentage),
                }):Play()
            end
            task.wait(0.15)
        end
    end

    local function applyGen(obj)
        if not active or gens[obj] or not obj.Parent then
            return
        end
        if not isGenModel(obj) then
            return
        end
        local c = Hub.Colors.GeneratorEsp
        local hl = Instance.new("Highlight")
        hl.Name = "SimpelGenEsp"
        hl.FillColor = c
        hl.FillTransparency = 0.7
        hl.OutlineColor = c
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = obj

        local bb = Instance.new("BillboardGui")
        bb.Name = "SimpelGenTag"
        bb.Size = UDim2.new(0, 100, 0, 10)
        bb.AlwaysOnTop = true
        bb.ResetOnSpawn = false
        bb.StudsOffset = Vector3.new(0, 0.5, 0)
        bb.DistanceLowerLimit = 0
        bb.DistanceUpperLimit = math.huge
        bb.Adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
        bb.Parent = obj

        local frame = Instance.new("Frame")
        frame.Name = "MainFrame"
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = BG_COLOR
        frame.BorderSizePixel = 1
        frame.BorderColor3 = BORDER_COLOR
        frame.Parent = bb

        local container = Instance.new("Frame")
        container.Name = "BarContainer"
        container.Size = UDim2.new(1, 0, 1, 0)
        container.BackgroundTransparency = 1
        container.ClipsDescendants = true
        container.Parent = frame

        local bar = Instance.new("Frame")
        bar.Name = "ProgressBar"
        bar.Size = UDim2.new(0, 0, 1, 0)
        bar.BorderSizePixel = 0
        bar.BackgroundColor3 = COLOR_START
        bar.Parent = container

        local label = Instance.new("TextLabel")
        label.Name = "ProgressText"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.ZIndex = 3
        label.Font = Enum.Font.GothamBold
        label.TextSize = 10
        label.TextColor3 = TEXT_COLOR
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.3
        label.Parent = frame

        local rec = { hl = hl, bb = bb, frame = frame, bar = bar, label = label }
        gens[obj] = rec
        local my = token
        task.spawn(runProgress, obj, rec, my)
    end

    local function clearAll()
        for obj, rec in pairs(gens) do
            pcall(function()
                rec.hl:Destroy()
            end)
            pcall(function()
                rec.bb:Destroy()
            end)
            gens[obj] = nil
        end
    end

    local function start()
        if active then
            return
        end
        active = true
        token = token + 1
        local my = token
        table.insert(conns, Workspace.DescendantAdded:Connect(function(inst)
            if inst:IsA("Model") then
                task.delay(0.3, function()
                    if active and token == my and inst.Parent then
                        applyGen(inst)
                    end
                end)
            end
        end))
        task.spawn(function()
            local ok, list = pcall(function()
                return Workspace:GetDescendants()
            end)
            if not ok or not list then
                return
            end
            for i = 1, #list do
                if not (active and token == my) then
                    return
                end
                local inst = list[i]
                if inst:IsA("Model") then
                    applyGen(inst)
                end
                if i % 3000 == 0 then
                    task.wait()
                end
            end
        end)
    end

    local function stop()
        if not active then
            return
        end
        active = false
        token = token + 1
        FX.disconnectAll(conns)
        clearAll()
    end

    Hub.OnChange("GeneratorEsp", function(on)
        if on then
            start()
        else
            stop()
        end
    end)

    Hub.OnColor("GeneratorEsp", function(c)
        for _, rec in pairs(gens) do
            pcall(function()
                rec.hl.FillColor = c
                rec.hl.OutlineColor = c
            end)
        end
    end)
end

do
    local C = {
        RADIUS = 14.5,
        ANGLE = 90,
        ARC = 16,
        THICK = 0.12,
        TRANSP = 0.15,
        GROUND = 0.12,
        STEP = 1,
        MAXDEV = 2,
        MAXDIST = 100,
    }
    local active = false
    local conn = nil
    local fovObjs = {}
    local fovScanT = 0
    local rayFilterT = 0
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true

    local function destroyFovObj(char)
        local o = fovObjs[char]
        if not o then
            return
        end
        fovObjs[char] = nil
        for _, b in ipairs(o.boxes) do
            pcall(function()
                b:Destroy()
            end)
        end
    end

    local function destroyAllFov()
        for char in pairs(fovObjs) do
            destroyFovObj(char)
        end
    end

    local function hideFovObj(o)
        if o.shown then
            o.shown = false
            for _, b in ipairs(o.boxes) do
                b.Visible = false
            end
        end
    end

    local function createFovObj(root, cam)
        local N = C.ARC
        local R = C.RADIUS
        local half = math.rad(C.ANGLE / 2)
        local xz = {}
        xz[1] = Vector3.new(0, 0, 0)
        for k = 0, N do
            local phi = -half + (2 * half) * (k / N)
            xz[2 + k] = Vector3.new(math.sin(phi) * R, 0, -math.cos(phi) * R)
        end
        local boxes = {}
        for i = 1, N + 2 do
            local b = Instance.new("BoxHandleAdornment")
            b.Name = "SimpelFov"
            b.Adornee = root
            b.AlwaysOnTop = false
            b.ZIndex = 1
            b.Color3 = Hub.Colors.FovKillerOutline
            b.Transparency = C.TRANSP
            b.Size = Vector3.new(C.THICK, 0.06, 1)
            b.Visible = false
            b.Parent = cam
            boxes[i] = b
        end
        return { root = root, boxes = boxes, xz = xz, gy = nil, lastSample = 0, shown = false }
    end

    local function groundY(x, z, topY)
        local res = workspace:Raycast(Vector3.new(x, topY, z), Vector3.new(0, -40, 0), rayParams)
        if res then
            return res.Position.Y
        end
        return nil
    end

    local function setSeg(b, a, c)
        local d = c - a
        local len = d.Magnitude
        if len < 0.01 then
            b.Visible = false
            return
        end
        local mid = (a + c) / 2
        b.Size = Vector3.new(C.THICK, 0.06, len + C.THICK)
        b.CFrame = CFrame.new(mid, mid + d)
        b.Visible = true
    end

    local function updateFovObj(o, cam, now)
        local root = o.root
        if not (root and root.Parent) then
            hideFovObj(o)
            return
        end
        local char = root.Parent
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            hideFovObj(o)
            return
        end
        local rpos = root.Position
        if (rpos - cam.CFrame.Position).Magnitude > C.MAXDIST then
            hideFovObj(o)
            return
        end
        local xz = o.xz
        local total = #xz
        if (not o.gy) or now - o.lastSample >= 0.1 then
            o.lastSample = now
            local hip = hum.HipHeight
            if hip < 0.1 then
                hip = 2
            end
            local fallback = rpos.Y - hip - root.Size.Y / 2
            local gy = o.gy or {}
            local apex = groundY(rpos.X, rpos.Z, rpos.Y + 1) or fallback
            gy[1] = apex
            local cf = root.CFrame
            local topY = apex + C.STEP
            for i = 2, total do
                local wp = cf:PointToWorldSpace(xz[i])
                local y = groundY(wp.X, wp.Z, topY)
                if (not y) or math.abs(y - apex) > C.MAXDEV then
                    y = apex
                end
                gy[i] = y
            end
            o.gy = gy
        end
        local gy = o.gy
        local lp = {}
        for i = 1, total do
            lp[i] = Vector3.new(xz[i].X, gy[i] - rpos.Y + C.GROUND, xz[i].Z)
        end
        local boxes = o.boxes
        setSeg(boxes[1], lp[1], lp[2])
        for i = 1, total - 2 do
            setSeg(boxes[1 + i], lp[1 + i], lp[2 + i])
        end
        setSeg(boxes[total], lp[total], lp[1])
        o.shown = true
    end

    local function updateKillerFov(now)
        local cam = workspace.CurrentCamera
        if not cam then
            return
        end
        if now - rayFilterT >= 1 then
            rayFilterT = now
            local list = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    table.insert(list, p.Character)
                end
            end
            rayParams.FilterDescendantsInstances = list
        end
        if now - fovScanT >= 0.25 then
            fovScanT = now
            local seen = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    local char = p.Character
                    if char and char.Parent and FX.isKillerChar(char, now) then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            seen[char] = true
                            local o = fovObjs[char]
                            if (not o) or o.root ~= root or (not o.boxes[1]) or o.boxes[1].Parent ~= cam then
                                if o then
                                    destroyFovObj(char)
                                end
                                fovObjs[char] = createFovObj(root, cam)
                            end
                        end
                    end
                end
            end
            for char in pairs(fovObjs) do
                if not seen[char] then
                    destroyFovObj(char)
                end
            end
        end
        for _, o in pairs(fovObjs) do
            updateFovObj(o, cam, now)
        end
    end

    local function start()
        if active then
            return
        end
        active = true
        fovScanT = 0
        rayFilterT = 0
        conn = RunService.Heartbeat:Connect(function()
            if not active then
                return
            end
            pcall(updateKillerFov, os.clock())
        end)
    end

    local function stop()
        if not active then
            return
        end
        active = false
        if conn then
            pcall(function()
                conn:Disconnect()
            end)
            conn = nil
        end
        destroyAllFov()
    end

    Hub.OnChange("FovKillerOutline", function(on)
        if on then
            start()
        else
            stop()
        end
    end)

    Hub.OnColor("FovKillerOutline", function(c)
        for _, o in pairs(fovObjs) do
            for _, b in ipairs(o.boxes) do
                pcall(function()
                    b.Color3 = c
                end)
            end
        end
    end)
end

