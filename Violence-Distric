local cfgIndex = { configs = {}, autoload = nil }
local activeName, selectedName = nil, nil

local function loadIndex()
    local idx = { configs = {}, autoload = nil }
    local raw = readData(CONFIG_FILE)
    if raw then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if ok and type(data) == "table" and type(data.configs) == "table" then
            for name, c in pairs(data.configs) do
                if type(name) == "string" and type(c) == "table" then
                    idx.configs[name] = c
                end
            end
            if type(data.autoload) == "string" and idx.configs[data.autoload] then
                idx.autoload = data.autoload
            end
        end
    end
    cfgIndex = idx
end

local function persistIndex()
    local ok, json = pcall(function()
        return HttpService:JSONEncode({
            version = 2,
            configs = cfgIndex.configs,
            autoload = cfgIndex.autoload,
        })
    end)
    if not ok or type(json) ~= "string" then
        return false, nil
    end
    local mode = writeData(CONFIG_FILE, json)
    return true, mode
end

