    end

    local rBox = makeChannel(15, "Red")
    local gBox = makeChannel(123, "Green")
    local bBox = makeChannel(231, "Blue")

    local cancelBtn = create("TextButton", {
        Position = UDim2.new(0, 15, 0, 324),
        Size = UDim2.new(0, 150, 0, 46),
