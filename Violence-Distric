local movers = {}

local function clampAxis(v, half, total)
    local lo = half + 4
    local hi = total - half - 4
    if hi < lo then
        return total / 2
    end
    return clamp(v, lo, hi)
end

local function newMover(frame, opts)
    local m = { frame = frame, opts = opts, x = 0, y = 0, tx = 0, ty = 0 }
    function m.setTarget(x, y, instant)
        local vp = viewport()
        local sz = opts.size()
        local cx = clampAxis(x, sz.X / 2, vp.X)
        local cy = clampAxis(y, sz.Y / 2, vp.Y)
        m.tx, m.ty = cx, cy
        if instant then
            m.x, m.y = cx, cy
            frame.Position = UDim2.new(cx / vp.X, 0, cy / vp.Y, 0)
        end
    end
    function m.getFraction()
        local vp = viewport()
        return m.tx / vp.X, m.ty / vp.Y
    end
    function m.setFraction(fx, fy, instant)
        local vp = viewport()
        m.setTarget(fx * vp.X, fy * vp.Y, instant)
    end
    movers[m] = true
    return m
end

track(RunService.RenderStepped:Connect(function(dt)
    local a = 1 - math.exp(-dt * 22)
    local vp = viewport()
    for m in pairs(movers) do
        local dx, dy = m.tx - m.x, m.ty - m.y
        if dx ~= 0 or dy ~= 0 then
            if math.abs(dx) < 0.15 and math.abs(dy) < 0.15 then
                m.x, m.y = m.tx, m.ty
            else
                m.x = m.x + dx * a
                m.y = m.y + dy * a
            end
            m.frame.Position = UDim2.new(m.x / vp.X, 0, m.y / vp.Y, 0)
        end
    end
end))

local currentDrag = nil

local function attachDrag(m, handle)
    handle.InputBegan:Connect(function(input)
        if not isPointer(input) then
            return
        end
        local canMove = true
        if m.opts.canDrag then
            canMove = m.opts.canDrag()
        end
        currentDrag = {
            m = m,
            input = input,
            sx = input.Position.X,
            sy = input.Position.Y,
            ox = m.tx,
            oy = m.ty,
            moved = false,
            canMove = canMove,
        }
        if m.opts.onPress then
            m.opts.onPress()
        end
    end)
end

track(UserInputService.InputChanged:Connect(function(input)
    local d = currentDrag
    if not d then
        return
    end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input == d.input then
        local dx = input.Position.X - d.sx
        local dy = input.Position.Y - d.sy
        if not d.moved and (dx * dx + dy * dy) > 36 then
            d.moved = true
        end
        if d.moved and d.canMove then
            d.m.setTarget(d.ox + dx, d.oy + dy, false)
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    local d = currentDrag
    if not d then
        return
    end
    local same = input == d.input
        or (input.UserInputType == Enum.UserInputType.MouseButton1 and d.input.UserInputType == Enum.UserInputType.MouseButton1)
    if not same then
        return
    end
    currentDrag = nil
    if d.m.opts.onRelease then
        d.m.opts.onRelease()
    end
    if d.moved then
        if d.m.opts.onMoved then
            d.m.opts.onMoved()
        end
    else
        if d.m.opts.onClick then
            d.m.opts.onClick()
        end
    end
end))

local function ripple(btn, input)
    local size = btn.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then
        return
    end
    local rx = input.Position.X - btn.AbsolutePosition.X
    local ry = input.Position.Y - btn.AbsolutePosition.Y
    local maxD = math.max(size.X, size.Y) * 2.4
    local dot = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(rx, ry),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = ACCENT,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, btn)
    corner(dot, 999)
    tween(dot, 0.45, { Size = UDim2.fromOffset(maxD, maxD), BackgroundTransparency = 1 })
    task.delay(0.5, function()
        pcall(function()
            dot:Destroy()
        end)
    end)
end

local function attachPress(btn, callback)
    btn.InputBegan:Connect(function(input)
        if isPointer(input) then
            ripple(btn, input)
        end
    end)
    btn.Activated:Connect(callback)
end

local function hoverable(btn, base, over)
    btn.MouseEnter:Connect(function()
        tween(btn, 0.12, { BackgroundTransparency = over })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.12, { BackgroundTransparency = base })
    end)
end

