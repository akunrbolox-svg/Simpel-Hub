buildConfig = function()
    local cfg = { version = 1, state = {}, colors = {}, panel = { locked = panelState.locked, items = {} } }
    for _, key in ipairs(ORDER) do
        cfg.state[key] = Hub.State[key]
    end
    for key, c in pairs(Hub.Colors) do
        cfg.colors[key] = { toByte(c.R), toByte(c.G), toByte(c.B) }
    end
    local wx, wy = winMover.getFraction()
    cfg.window = { x = wx, y = wy }
    local mx, my = miniMover.getFraction()
    cfg.mini = { x = mx, y = my, placed = miniPlaced }
    for _, it in ipairs(PANEL_ITEMS) do
        local f = floaters[it.key]
        if f then
            local fx, fy = f.mover.getFraction()
            cfg.panel.items[it.key] = { enabled = true, x = fx, y = fy }
        else
            cfg.panel.items[it.key] = { enabled = false }
        end
    end
    return cfg
end

saveConfig = function(name)
    if type(name) ~= "string" or name == "" then
        return false, nil
    end
    local previous = cfgIndex.configs[name]
    cfgIndex.configs[name] = buildConfig()
    local ok, mode = persistIndex()
    if not ok then
        cfgIndex.configs[name] = previous
    end
    return ok, mode
end

applyConfig = function(cfg, withWindow)
    if type(cfg) ~= "table" then
        return
    end
    if type(cfg.colors) == "table" then
        for key in pairs(COLOR_DEFAULTS) do
            local c = cfg.colors[key]
            if type(c) == "table" then
                local r, g, b = tonumber(c[1]), tonumber(c[2]), tonumber(c[3])
                if r and g and b then
                    setColor(key, Color3.fromRGB(clamp(r, 0, 255), clamp(g, 0, 255), clamp(b, 0, 255)))
                end
            end
        end
    end
    if withWindow then
        if type(cfg.window) == "table" then
            local fx, fy = tonumber(cfg.window.x), tonumber(cfg.window.y)
            if fx and fy then
                winMover.setFraction(clamp(fx, 0, 1), clamp(fy, 0, 1), true)
            end
        end
        if type(cfg.mini) == "table" then
            local fx, fy = tonumber(cfg.mini.x), tonumber(cfg.mini.y)
            if fx and fy then
                miniMover.setFraction(clamp(fx, 0, 1), clamp(fy, 0, 1), true)
                miniPlaced = cfg.mini.placed == true
            end
        end
    end
    if type(cfg.panel) == "table" then
        panelState.locked = cfg.panel.locked == true
        lockRefresh()
        local items = {}
        if type(cfg.panel.items) == "table" then
            items = cfg.panel.items
        end
        for _, it in ipairs(PANEL_ITEMS) do
            local data = items[it.key]
            if type(data) == "table" and data.enabled == true then
                local fx, fy = tonumber(data.x), tonumber(data.y)
                if fx and fy then
                    fx, fy = clamp(fx, 0, 1), clamp(fy, 0, 1)
                    local f = floaters[it.key]
                    if f then
                        f.mover.setFraction(fx, fy, true)
                        panelSetEnabled(it.key, true)
                    else
                        panelSetEnabled(it.key, true, fx, fy)
                    end
                else
                    panelSetEnabled(it.key, true)
                end
            else
                panelSetEnabled(it.key, false)
            end
        end
    end
    if type(cfg.state) == "table" then
        for _, key in ipairs(ORDER) do
            local value = cfg.state[key]
            if value ~= nil then
                setState(key, value)
            end
        end
    end
end

