local hopBusy = false

local function httpGet(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and body ~= "" then
        return body
    end
    local okReq, req = pcall(function()
        return (syn and syn.request) or (http and http.request) or http_request or request
    end)
    if okReq and type(req) == "function" then
        local ok2, res = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(res) == "table" and type(res.Body) == "string" then
            return res.Body
        end
    end
    return nil
end

local function hopServer()
    if hopBusy then
        return
    end
    hopBusy = true
    toast("Mencari server lain...")
    task.spawn(function()
        local target = nil
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
            local body = httpGet(url)
            if not body then
                return
            end
            local data = HttpService:JSONDecode(body)
            local candidates = {}
            if type(data) == "table" and type(data.data) == "table" then
                for _, sv in ipairs(data.data) do
                    if type(sv) == "table" and sv.id ~= game.JobId
                        and tonumber(sv.playing) and tonumber(sv.maxPlayers)
                        and sv.playing < sv.maxPlayers then
                        candidates[#candidates + 1] = sv.id
                    end
                end
            end
            if #candidates > 0 then
                target = candidates[math.random(1, #candidates)]
            end
        end)
        if target then
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, target, player)
            end)
            if not ok then
                toast("Gagal pindah server")
            end
        else
            toast("Server lain tidak ditemukan")
            pcall(function()
                TeleportService:Teleport(game.PlaceId, player)
            end)
        end
        task.delay(5, function()
            hopBusy = false
        end)
    end)
end

local function rejoinServer()
    toast("Menghubungkan ulang...")
    task.spawn(function()
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end)
        if not ok then
            pcall(function()
                TeleportService:Teleport(game.PlaceId, player)
            end)
        end
    end)
end

local function respawnCharacter()
    local ok = pcall(function()
        local char = player.Character
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        else
            char:BreakJoints()
        end
    end)
    if ok then
        toast("Respawn dijalankan")
    else
        toast("Respawn gagal")
    end
end

