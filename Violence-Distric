local function refreshConfigList()
    for _, ch in ipairs(listHolder:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
    local names = {}
    for name in pairs(cfgIndex.configs) do
        names[#names + 1] = name
    end
    table.sort(names, function(a, b)
        return string.lower(a) < string.lower(b)
    end)
    if selectedName and not cfgIndex.configs[selectedName] then
        selectedName = nil
    end
    if #names == 0 then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Text = "Belum ada config tersimpan",
            TextColor3 = SUBTEXT,
            Font = FONT,
            TextSize = 12,
            LayoutOrder = 1,
        }, listHolder)
    end
    for i, name in ipairs(names) do
        local isSel = (name == selectedName)
        local isAuto = (cfgIndex.autoload == name)
        local b = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = isSel and ACCENT or SURFACE,
            BackgroundTransparency = isSel and 0 or 0.25,
            BorderSizePixel = 0,
            Text = (isAuto and "[AUTO]  " or "") .. name,
            TextColor3 = isSel and DARK_TEXT or TEXT,
            Font = FONT_BOLD,
            TextSize = 12,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            ClipsDescendants = true,
            LayoutOrder = i,
        }, listHolder)
        corner(b, 8)
        attachPress(b, function()
            playSound("click")
            selectedName = name
            task.defer(refreshConfigList)
        end)
    end
    cfgStatus.Text = "Dipilih: " .. (selectedName or "-") .. "\nAuto Load: " .. (cfgIndex.autoload or "-")
end

