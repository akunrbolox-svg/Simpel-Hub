    create("TextLabel", {
        Position = UDim2.new(0, 0, 0, 5),
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = TEXT,
        Font = FONT,
        TextSize = 11,
    }, f)
    local statL = create("TextLabel", {
        Position = UDim2.new(0, 0, 0, 21),
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = "OFF",
        TextColor3 = SUBTEXT,
        Font = FONT_BOLD,
        TextSize = 14,
    }, f)
    local m = newMover(f, {
        size = function()
            return Vector2.new(104, 46)
        end,
        canDrag = function()
            return not panelState.locked
        end,
        onPress = function()
            tween(sc, 0.08, { Scale = 0.93 })
        end,
        onRelease = function()
            tween(sc, 0.12, { Scale = 1 })
        end,
        onClick = function()
            local nv = not Hub.State[key]
            playSound(nv and "on" or "off")
            setState(key, nv)
        end,
    })
    attachDrag(m, f)
    local vp = viewport()
    if fx and fy then
        m.setFraction(fx, fy, true)
    else
        local idx = floaterCount()
        m.setTarget(vp.X - 70, vp.Y * 0.28 + idx * 58, true)
    end
    local refreshFn = register(key, function(value, instant)
        statL.Text = value and "ON" or "OFF"
        statL.TextColor3 = value and ACCENT or SUBTEXT
        local sc2 = value and ACCENT or OFF_COLOR
        if instant then
            st.Color = sc2
        else
            tween(st, 0.18, { Color = sc2 })
        end
    end)
    floaters[key] = { frame = f, mover = m, refresh = refreshFn }
end

local function panelSetEnabled(key, enabled, fx, fy)
    if enabled then
        local label = key
        for _, it in ipairs(PANEL_ITEMS) do
            if it.key == key then
