local function viewport()
    local cam = workspace.CurrentCamera
    if cam then
        local v = cam.ViewportSize
        if v.X > 0 and v.Y > 0 then
            return v
        end
    end
    local a = screenGui.AbsoluteSize
    if a.X > 0 and a.Y > 0 then
        return a
    end
    return Vector2.new(800, 400)
end

