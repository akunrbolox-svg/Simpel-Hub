        end
        if getconnections then
            local ok, list = pcall(getconnections, btn.MouseButton1Down)
            if ok and list then
                local fired = false
                for _, c in ipairs(list) do
                    local o = pcall(function()
                        c:Fire()
                    end)
                    if o then
                        fired = true
                    end
                end
                return fired
            end
        end
        return false
    end

    local function isFacing(kroot, delta)
        if not CFG.CHECK_FACING then
            return true
        end
        local look = kroot.CFrame.LookVector
        local lx, lz = look.X, look.Z
        local dx, dz = delta.X, delta.Z
        local ll = math.sqrt(lx * lx + lz * lz)
        local dl = math.sqrt(dx * dx + dz * dz)
        if ll < 0.01 or dl < 0.05 then
            return true
        end
        return ((lx * dx + lz * dz) / (ll * dl)) >= CFG.FACING_MIN_DOT
    end

    local function isBlocked(rec, kroot, now)
        if not CFG.CHECK_LOS then
            return false
        end
        if now - rec.losT < CFG.LOS_INTERVAL then
            return rec.losBlocked
        end
        rec.losT = now
        if not losParams then
            losParams = RaycastParams.new()
            losParams.FilterType = Enum.RaycastFilterType.Exclude
            losParams.RespectCanCollide = true
            losParams.IgnoreWater = true
        end
        local list = {}
        local n = 0
        for _, p in ipairs(Players:GetPlayers()) do
            local c = p.Character
            if c then
                n = n + 1
                list[n] = c
            end
        end
        if myChar then
            n = n + 1
            list[n] = myChar
        end
        local kc = rec.data and rec.data.char
        if kc then
            n = n + 1
            list[n] = kc
        end
        local okSet = pcall(function()
            losParams.FilterDescendantsInstances = list
        end)
        if not okSet then
            rec.losBlocked = false
            return false
        end
        local origin = kroot.Position
        local dir = myRoot.Position - origin
        local ok, result = pcall(workspace.Raycast, workspace, origin, dir, losParams)
        if ok then
            rec.losBlocked = (result ~= nil)
        else
            rec.losBlocked = false
        end
        return rec.losBlocked
    end

    local function tryPress(rec, kroot, delta)
        if rec.fires >= CFG.MAX_FIRES then
            return
        end
        local t = os.clock()
        if t - rec.lastTry < CFG.REFIRE then
            return
        end
        if not isFacing(kroot, delta) then
            return
        end
        if isBlocked(rec, kroot, t) then
            return
        end
        rec.lastTry = t
        if pressParry() then
            rec.fires = rec.fires + 1
        end
    end

    local function effectiveDistance(kroot, delta, dist)
        local effDist = dist
        if dist > 0.001 and ping > 0 then
            local rv = kroot.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
            local closing = rv:Dot(delta.Unit)
            if closing > 0 then
                effDist = dist - closing * ping
            end
        end
        return effDist
    end

    local function processRecord(rec, now, fresh)
        local track = rec.track
        if (not fresh) and (not track.IsPlaying) and (now - rec.start > 0.1) then
            if attacks[track] == rec then
                attacks[track] = nil
            end
            return false
        end
        if not (myRoot and myRoot.Parent) then
            return false
        end
        local kroot = rec.kroot
        if not (kroot and kroot.Parent) then
            kroot = rec.data.char:FindFirstChild("HumanoidRootPart")
            rec.kroot = kroot
            if not kroot then
                return false
            end
        end
        local range = Hub.State.ParryRange
        local delta = myRoot.Position - kroot.Position
        local dist = delta.Magnitude
        local inRange = dist <= range
        if rec.armed == nil then
            if myAlive then
                rec.armed = effectiveDistance(kroot, delta, dist) <= range
            else
                rec.armed = false
            end
        end
        if not rec.armed then
            return false
        end
        if (not Hub.State.AutoParry) or (not myAlive) then
            return inRange
        end
        local effDist = effectiveDistance(kroot, delta, dist)
        if effDist <= range then
            local hit = HIT_TIME[rec.id]
            if hit and (now - rec.start) < (hit - ping - CFG.PARRY_LEAD) then
                return inRange
            end
            tryPress(rec, kroot, delta)
        end
        return inRange
    end

    local function register(d, track, id, isEvent)
        local now = os.clock()
        local rec = attacks[track]
        if rec then
            if isEvent then
                rec.start = now
                rec.fires = 0
                rec.lastTry = -math.huge
                rec.armed = nil
                rec.losT = -math.huge
                rec.losBlocked = false
            end
            return rec
        end
        rec = {
            data = d,
            track = track,
            id = id,
            start = now,
            fires = 0,
            lastTry = -math.huge,
            kroot = nil,
            armed = nil,
            losT = -math.huge,
            losBlocked = false,
        }
        attacks[track] = rec
        local c
        c = track.Stopped:Connect(function()
            if attacks[track] == rec then
                attacks[track] = nil
            end
            if c then
                c:Disconnect()
            end
        end)
        return rec
    end

    local function isKillerData(d)
        if d.isKiller then
            return true
        end
        if d.char and d.char.Parent then
            local f = d.char:FindFirstChild("Lookscriptkiller", true)
            if f then
                d.isKiller = true
                return true
            end
        end
        return false
    end

    local function onAnimPlayed(d, track)
        if not running then
            return
        end
        local id = animIdOf(track)
        if not id or not ATTACK_IDS[id] then
            return
        end
        if not isKillerData(d) then
            return
        end
        updateSelf()
        local rec = register(d, track, id, true)
        if rec then
            processRecord(rec, os.clock(), true)
        end
    end

    local function unhookChar(char)
        local d = charData[char]
        if not d then
            return
        end
        charData[char] = nil
        for _, c in ipairs(d.conns) do
            pcall(function()
                c:Disconnect()
            end)
        end
        if d.animConn then
            pcall(function()
                d.animConn:Disconnect()
            end)
        end
        for tr, rec in pairs(attacks) do
            if rec.data == d then
                attacks[tr] = nil
            end
        end
    end

    local function hookAnimator(d, animator)
        if d.animConn then
            pcall(function()
                d.animConn:Disconnect()
            end)
        end
        d.animator = animator
        d.animConn = animator.AnimationPlayed:Connect(function(track)
            onAnimPlayed(d, track)
        end)
    end

    local function hookChar(char)
        if charData[char] then
            return
        end
        local d = { char = char, conns = {}, isKiller = false, animator = nil, animConn = nil }
        charData[char] = d
        table.insert(d.conns, char.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                unhookChar(char)
            end
        end))
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 20)
            if not hum or charData[char] ~= d or not running then
                return
            end
            table.insert(d.conns, hum.ChildAdded:Connect(function(c)
                if c:IsA("Animator") then
                    hookAnimator(d, c)
                end
            end))
            local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 20)
            if animator and charData[char] == d and running then
                hookAnimator(d, animator)
            end
        end)
    end

    local function hookPlayer(p)
        if p == player or playerConns[p] then
            return
        end
        local list = {}
        playerConns[p] = list
        table.insert(list, p.CharacterAdded:Connect(function(c)
            hookChar(c)
        end))
        if p.Character then
            hookChar(p.Character)
        end
    end

    local function unhookPlayer(p)
        local list = playerConns[p]
        if list then
            for _, c in ipairs(list) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            playerConns[p] = nil
        end
        if p.Character then
            unhookChar(p.Character)
        end
    end

    local function ensureRing()
        local cam = workspace.CurrentCamera or workspace
        if ring and ring.Parent == cam then
            return ring
        end
        if ring then
            pcall(function()
                ring:Destroy()
            end)
        end
        ring = Instance.new("CylinderHandleAdornment")
        ring.Name = "SimpelParryRing"
        ring.Height = 0.1
        ring.AlwaysOnTop = false
        ring.ZIndex = 1
        ring.Transparency = CFG.RING_TRANSPARENCY
        ring.Radius = Hub.State.ParryRange
        ring.InnerRadius = math.max(0, Hub.State.ParryRange - CFG.RING_THICKNESS)
        ring.Color3 = Hub.Colors.RangeParry
        ringLastColor = Hub.Colors.RangeParry
        ringLastDy = nil
        ring.Parent = cam
        return ring
    end

    local function getGroundDy()
        if not (myRoot and myRoot.Parent) then
            return nil
        end
        if not rayParams then
            rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.RespectCanCollide = true
        end
        if rayChar ~= myChar then
            rayChar = myChar
            if myChar then
                rayParams.FilterDescendantsInstances = { myChar }
            else
                rayParams.FilterDescendantsInstances = {}
            end
        end
        local origin = myRoot.Position
        local ok, result = pcall(workspace.Raycast, workspace, origin, Vector3.new(0, -30, 0), rayParams)
        if ok and result then
            return (result.Position.Y + CFG.RING_GROUND_OFFSET) - origin.Y
        end
        local hip = myHum and myHum.HipHeight or 0
        if hip < 0.1 then
            hip = 2
        end
        return -(hip + myRoot.Size.Y / 2) + CFG.RING_GROUND_OFFSET
    end

    local function updateRing(anyIn)
        if not (Hub.State.ParryVisual and myRoot and myRoot.Parent and myAlive) then
            if ring then
                ring.Visible = false
            end
            return
        end
        local r = ensureRing()
        if r.Adornee ~= myRoot then
            r.Adornee = myRoot
        end
        local range = Hub.State.ParryRange
        if r.Radius ~= range then
            r.InnerRadius = 0
            r.Radius = range
            r.InnerRadius = math.max(0, range - CFG.RING_THICKNESS)
        end
        local dy = getGroundDy()
        if dy and (ringLastDy == nil or math.abs(ringLastDy - dy) > 0.01) then
            ringLastDy = dy
            r.CFrame = CFrame.new(0, dy, 0) * CFrame.Angles(math.rad(90), 0, 0)
        end
        local col = anyIn and COLOR_RING_ACTIVE or Hub.Colors.RangeParry
        if ringLastColor ~= col then
            ringLastColor = col
            r.Color3 = col
        end
        r.Visible = true
    end

    local function startRun()
        if running then
            return
        end
        running = true
        updateSelf()
        table.insert(conns, Players.PlayerAdded:Connect(hookPlayer))
        table.insert(conns, Players.PlayerRemoving:Connect(unhookPlayer))
        for _, p in ipairs(Players:GetPlayers()) do
            hookPlayer(p)
        end
        local lastPingT, lastScanT = 0, 0
        table.insert(conns, RunService.Heartbeat:Connect(function()
            if not running then
                return
            end
            local now = os.clock()
            updateSelf()
            if now - lastPingT >= 0.5 then
                lastPingT = now
                refreshPing()
            end
            if now - lastScanT >= 1 then
                lastScanT = now
                for _, d in pairs(charData) do
                    if not d.isKiller then
                        isKillerData(d)
                    end
                end
            end
            for _, d in pairs(charData) do
                if d.isKiller and d.animator then
                    local ok, tracks = pcall(d.animator.GetPlayingAnimationTracks, d.animator)
                    if ok and tracks then
                        for i = 1, #tracks do
                            local tr = tracks[i]
                            if not attacks[tr] then
                                local id = animIdOf(tr)
                                if id and ATTACK_IDS[id] then
                                    register(d, tr, id, false)
                                end
                            end
                        end
                    end
                end
            end
            local anyIn = false
            for _, rec in pairs(attacks) do
                if processRecord(rec, now, false) then
                    anyIn = true
                end
            end
            updateRing(anyIn)
        end))
    end

    local function stopRun()
        if not running then
            return
        end
        running = false
        FX.disconnectAll(conns)
        for p in pairs(playerConns) do
            unhookPlayer(p)
        end
        for char in pairs(charData) do
            unhookChar(char)
        end
        attacks = {}
        if ring then
            pcall(function()
                ring:Destroy()
            end)
            ring = nil
        end
    end

    local function refresh()
        if Hub.State.AutoParry or Hub.State.ParryVisual then
            startRun()
        else
            stopRun()
        end
    end

    Hub.OnChange("AutoParry", function(on)
        if on and not (firesignal or getconnections) and Hub.Notify then
            Hub.Notify("firesignal tidak tersedia di executor ini")
        end
        refresh()
    end)
    Hub.OnChange("ParryVisual", function()
        refresh()
    end)
end

do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local SUCCESS_MIN, SUCCESS_MAX = 102, 116
    local NEUTRAL_MIN, NEUTRAL_MAX = 116, 159
    local INSTANT_ANGLE = 109
    local TRIGGER_DELAY = 0.035
    local SCOURGE_TIMEOUT = 15

    local active = false
    local token = 0
    local conns = {}
    local Busy = false
    local ScourgeActive = false
    local LastVisible = 0
    local PreviousVisible = false
    local LastTrigger = 0
    local Check, Line, Goal, Action = nil, nil, nil, nil

    local function curMode()
        return string.upper(tostring(Hub.State.AutoGeneratorSkill))
    end

    local function curScourge()
        return string.upper(tostring(Hub.State.AutoGeneratorKing))
    end

    local function RefreshReferences()
        pcall(function()
            local pg = player:FindFirstChildOfClass("PlayerGui")
            if not pg then
                return
            end
            local skillGui = pg:FindFirstChild("SkillCheckPromptGui")
            local newCheck = nil
            if skillGui then
                newCheck = skillGui:FindFirstChild("Check")
            end
            Check = newCheck
            if newCheck then
                Line = newCheck:FindFirstChild("Line")
                Goal = newCheck:FindFirstChild("Goal")
            else
                Line = nil
                Goal = nil
            end
            local survivor = pg:FindFirstChild("Survivor-mob")
            local controls = nil
            if survivor then
                controls = survivor:FindFirstChild("Controls")
            end
            if controls then
                Action = controls:FindFirstChild("action")
            else
                Action = nil
            end
        end)
    end

    local function TriggerAction()
        if not Action or not Action.Parent then
            RefreshReferences()
        end
        if not Action then
            return false
        end
        local Now = os.clock()
        if Now - LastTrigger < TRIGGER_DELAY then
            return false
        end
        LastTrigger = Now
        pcall(function()
            if Action:IsA("GuiButton") then
                Action:Activate()
            end
        end)
        if typeof(firesignal) == "function" then
            pcall(function()
                firesignal(Action.MouseButton1Down)
            end)
        end
        return true
    end

    local function GetAngle()
        if not Line or not Goal then
            return nil
        end
        return tonumber(Line.Rotation) or 0, tonumber(Goal.Rotation) or 0
    end

    local function IsPerfect()
        local LineRotation, GoalRotation = GetAngle()
        if not LineRotation then
            return false
        end
        return LineRotation >= GoalRotation + SUCCESS_MIN
            and LineRotation <= GoalRotation + SUCCESS_MAX
    end

    local function IsNormal()
        local LineRotation, GoalRotation = GetAngle()
        if not LineRotation then
            return false
        end
        return LineRotation > GoalRotation + NEUTRAL_MIN
            and LineRotation <= GoalRotation + NEUTRAL_MAX
    end

    local function InstantNormal()
        if not Check or not Line or not Goal then
            RefreshReferences()
        end
        if not Check or not Line or not Goal then
            return
        end
        if not Check.Visible then
            return
        end
        local GoalRotation = tonumber(Goal.Rotation) or 0
        pcall(function()
            Line.Rotation = GoalRotation + INSTANT_ANGLE
        end)
        TriggerAction()
    end

    local function InstantScourge()
        if not active or not ScourgeActive then
            return false
        end
        if not Line or not Goal then
            RefreshReferences()
        end
        if not Line or not Goal then
            return false
        end
        local GoalRotation = tonumber(Goal.Rotation) or 0
        pcall(function()
            Line.Rotation = GoalRotation + INSTANT_ANGLE
        end)
        return TriggerAction()
    end

    local function OnScourgeStart()
        ScourgeActive = true
        Busy = false
        LastVisible = os.clock()
    end

    local function OnScourgeEnd()
        ScourgeActive = false
        Busy = false
    end

    local function start()
        if active then
            return
        end
        active = true
        token = token + 1
        local my = token
        Busy = false
        ScourgeActive = false
        PreviousVisible = false
        LastVisible = os.clock()
        RefreshReferences()

        task.spawn(function()
            while active and token == my do
                RefreshReferences()
                task.wait(0.5)
            end
        end)

        task.spawn(function()
            while active and token == my do
                local ok, startRemote, endRemote = pcall(function()
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    local perks = remotes and remotes:FindFirstChild("KillerPerks")
                    local scourge = perks and perks:FindFirstChild("kingscourge")
                    if not scourge then
                        return nil, nil
                    end
                    return scourge:FindFirstChild("KingScourgeStart"),
                        scourge:FindFirstChild("KingScourgeEnd")
                end)
                if ok and startRemote and endRemote then
                    local c1 = startRemote.OnClientEvent:Connect(OnScourgeStart)
                    local c2 = endRemote.OnClientEvent:Connect(OnScourgeEnd)
                    if active and token == my then
                        table.insert(conns, c1)
                        table.insert(conns, c2)
                    else
                        c1:Disconnect()
                        c2:Disconnect()
                    end
                    return
                end
                task.wait(1)
            end
        end)

        table.insert(conns, RunService.RenderStepped:Connect(function()
            if not active then
                return
            end
            local Now = os.clock()
            if not Check or not Check.Parent then
                RefreshReferences()
            end
            local Visible = Check ~= nil and Check.Parent ~= nil and Check.Visible == true
            if Visible then
                LastVisible = Now
            elseif ScourgeActive and Now - LastVisible > SCOURGE_TIMEOUT then
                ScourgeActive = false
                Busy = false
            end
            local WasVisible = PreviousVisible
            PreviousVisible = Visible
            if not Visible then
                return
            end
            local Mode = curMode()
            if not WasVisible then
                Busy = false
                if not ScourgeActive and Mode == "INSTANT" then
                    InstantNormal()
                end
            end
            if not ScourgeActive then
                if not Busy then
                    local ShouldTrigger = false
                    if Mode == "PERFECT" then
                        ShouldTrigger = IsPerfect()
                    elseif Mode == "NORMAL" then
                        ShouldTrigger = IsNormal()
                    end
                    if ShouldTrigger then
                        Busy = true
                        TriggerAction()
                        task.delay(0.07, function()
                            Busy = false
                        end)
                    end
                end
                return
            end
            if curScourge() == "NORMAL" then
                if not Busy and IsNormal() then
                    Busy = true
                    TriggerAction()
                    task.delay(0.06, function()
                        Busy = false
                    end)
                end
            end
        end))

        task.spawn(function()
            local HandledGoal = nil
            while active and token == my do
                if ScourgeActive and curScourge() == "INSTANT" then
                    RefreshReferences()
                    if Check and Check.Visible and Goal and Line then
                        local CurrentGoal = tonumber(Goal.Rotation) or 0
                        if HandledGoal == nil or math.abs(CurrentGoal - HandledGoal) > 1 then
                            if InstantScourge() then
                                HandledGoal = CurrentGoal
                            end
                        end
                    else
                        HandledGoal = nil
                    end
                else
                    HandledGoal = nil
                end
                task.wait(0.005)
            end
        end)

        table.insert(conns, player.CharacterAdded:Connect(function()
            Busy = false
            ScourgeActive = false
            PreviousVisible = false
            task.wait(1)
            if active and token == my then
                RefreshReferences()
            end
        end))
    end

    local function stop()
        if not active then
            return
        end
        active = false
        token = token + 1
        FX.disconnectAll(conns)
        Busy = false
        ScourgeActive = false
        PreviousVisible = false
    end

    Hub.OnChange("AutoGenerator", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

do
    local V = {
        MAX_PREDICT_SPEED = 60,
        MAX_TARGET_DISTANCE = 260,
        TARGET_STALE_TIME = 0.3,
        TARGET_HYSTERESIS = 3,
        LEAD_PING_MULT = 2.2,
        EXTRA_LEAD = 0.12,
        VELOCITY_SMOOTH = 0.25,
        STEER_DELAY = 0.35,
        STEER_MAX_TIME = 4,
        STEER_TURN_RATE = 18,
        STEER_NEAR_DIST = 60,
        STEER_STOP_DIST = 2.5,
        MIN_SPEED_RATIO = 0.4,
        WEAK_THROW_RATIO = 0.45,
        GRAVITY = 96,
        AIM_OFFSET_Y = 0,
        LABEL_TEXT = "[ TARGET ]",
        LABEL_SIZE = 16,
        LABEL_HEAD_OFFSET = 2,
    }
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local active = false
    local conns = {}
    local handlerFn = nil
    local aim = {
        target = nil,
        prevRoot = nil,
        updatedAt = 0,
        holding = false,
        job = nil,
        steer = nil,
        thrownRoot = nil,
        thrownName = nil,
        armedUntil = 0,
    }
    local tracker = setmetatable({}, { __mode = "k" })
    local usedParts = setmetatable({}, { __mode = "k" })
    local recent = {}
    local ping = 0
    local spearRemote = nil
    local vfxRemote = nil
    local label = nil

    local function refreshPing()
        local ok, v = pcall(function()
            return player:GetNetworkPing()
        end)
        if ok and type(v) == "number" then
            ping = math.clamp(v, 0, 0.4)
        end
    end

    local function findRemotes()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local killers = remotes and remotes:FindFirstChild("Killers")
        local veil = killers and killers:FindFirstChild("Veil")
        if veil then
            spearRemote = veil:FindFirstChild("Spearthrow")
            vfxRemote = veil:FindFirstChild("vfx")
        end
    end

    local function isCharacterPart(p)
        local m = p:FindFirstAncestorOfClass("Model")
        return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
    end

    local function resolveOrigin(origin)
        if typeof(origin) ~= "Vector3" then
            return nil
        end
        local char = player.Character
        local mr = char and char:FindFirstChild("HumanoidRootPart")
        if mr and (origin - mr.Position).Magnitude > 25 then
            return mr.Position + Vector3.new(0, 1.5, 0)
        end
        return origin
    end

    local function trackVelocity(root, now)
        local pos = root.Position
        local tr = tracker[root]
        if not tr then
            tracker[root] = { pos = pos, t = now, vel = Vector3.new(0, 0, 0) }
            return tracker[root].vel
        end
        if (pos - tr.pos).Magnitude < 0.001 then
            if now - tr.t > 0.15 then
                tr.vel = Vector3.new(0, 0, 0)
            end
            return tr.vel
        end
        local dt = now - tr.t
        if dt <= 0 or dt > 0.35 then
            tr.vel = Vector3.new(0, 0, 0)
        else
            local raw = (pos - tr.pos) / dt
            if raw.Magnitude > 180 then
                tr.vel = Vector3.new(0, 0, 0)
            else
                tr.vel = tr.vel:Lerp(raw, V.VELOCITY_SMOOTH)
            end
        end
        tr.pos = pos
        tr.t = now
        return tr.vel
    end

    local function solveDirection(origin, speed, base, hv, g, lead)
        local t = (base - origin).Magnitude / speed
        local dirOut = nil
        local aimPos = base
        for _ = 1, 6 do
            aimPos = base + hv * (t + lead)
            local d = aimPos - origin
            local hd = Vector3.new(d.X, 0, d.Z)
            local x = hd.Magnitude
            local y = d.Y
            if x < 0.01 then
                dirOut = Vector3.new(0, y >= 0 and 1 or -1, 0)
                t = math.abs(y) / speed
            elseif g <= 0 then
                dirOut = d.Unit
                t = d.Magnitude / speed
            else
                local v2 = speed * speed
                local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
                local theta
                if disc >= 0 then
                    theta = math.atan((v2 - math.sqrt(disc)) / (g * x))
                else
                    theta = math.rad(45)
                end
                local hdir = hd / x
                dirOut = hdir * math.cos(theta) + Vector3.new(0, math.sin(theta), 0)
                local vx = speed * math.cos(theta)
                if vx > 0.01 then
                    t = x / vx
                end
            end
        end
        if not dirOut or dirOut.X ~= dirOut.X or dirOut.Y ~= dirOut.Y or dirOut.Z ~= dirOut.Z then
            return nil
        end
        return dirOut, aimPos
    end

    local function computeSpearDirection(args)
        local t = aim.target
        if not t then
            return nil
        end
        if os.clock() - aim.updatedAt > V.TARGET_STALE_TIME then
            return nil
        end
        local root = t.root
        if not (root and root.Parent) then
            return nil
        end
        local speed = args[2]
        local origin = resolveOrigin(args[3])
        if not origin or type(speed) ~= "number" or speed <= 1 then
            return nil
        end
        local lead = ping * V.LEAD_PING_MULT + V.EXTRA_LEAD
        local base = root.Position + Vector3.new(0, V.AIM_OFFSET_Y, 0)
        local hv = t.hv or Vector3.new(0, 0, 0)
        local dir = solveDirection(origin, speed, base, hv, V.GRAVITY, lead)
        if not dir then
            return nil
        end
        aim.thrownRoot = root
        aim.thrownName = t.name
        return dir
    end

    local function beginJob(args)
        local origin = resolveOrigin(args[3])
        local speed = args[2]
        if not origin or type(speed) ~= "number" or speed <= 1 then
            return
        end
        if aim.thrownRoot == nil then
            return
        end
        local now = os.clock()
        aim.job = {
            t0 = now,
            origin = origin,
            speed = speed,
            dir = args[1],
            cands = {},
            part = nil,
            firstT = 0,
            samples = {},
            root = aim.thrownRoot,
            name = aim.thrownName,
        }
        aim.steer = nil
        aim.armedUntil = now + 3
    end

    local function onFire(self, ...)
        if spearRemote and self == spearRemote then
            local args = table.pack(...)
            aim.thrownRoot = nil
            aim.thrownName = nil
            local ok, newDir = pcall(computeSpearDirection, args)
            if ok and newDir then
                args[1] = newDir
            end
            pcall(beginJob, args)
            return args
        elseif vfxRemote and self == vfxRemote then
            local _, _, a3 = ...
            if type(a3) == "boolean" then
                aim.holding = a3
                aim.armedUntil = os.clock() + 3
            end
            return nil
        end
        return nil
    end

    local function finishJob(job, now)
        local s = job.samples
        local n = #s
        local avg = nil
        if n >= 2 then
            local span = s[n].t - s[1].t
            if span > 0.05 then
                avg = (s[n].pos - s[1].pos).Magnitude / span
            end
        end
        if job.root and job.root.Parent and job.part and job.part.Parent then
            local expected = job.speed
            if avg and avg < expected * V.WEAK_THROW_RATIO then
                return
            end
            aim.steer = {
                part = job.part,
                root = job.root,
                name = job.name,
                t0 = now,
                speed = avg or expected,
                minSpeed = expected * V.MIN_SPEED_RATIO,
                slow = 0,
            }
        end
    end

    local function pickPart(job, now)
        for i = 1, #recent do
            local e = recent[i]
            local p = e.part
            if p and p.Parent and e.t >= job.t0 - 0.5 and not usedParts[p] and not job.cands[p] and not isCharacterPart(p) then
                if (p.Position - job.origin).Magnitude <= 40 then
                    job.cands[p] = { pos = p.Position, t = now }
                end
            end
        end
        local best, bestSpeed = nil, 0
        for p, c in pairs(job.cands) do
            if not p.Parent then
                job.cands[p] = nil
            else
                local age = now - c.t
                if age >= 0.1 then
                    local sp = (p.Position - c.pos).Magnitude / age
                    if sp > bestSpeed then
                        bestSpeed = sp
                        best = p
                    end
                end
            end
        end
        if best and bestSpeed >= job.speed * 0.3 then
            return best
        end
        return nil
    end

    local function stepJob(now)
        for i = #recent, 1, -1 do
            if now - recent[i].t > 4 then
                table.remove(recent, i)
            end
        end
        local job = aim.job
        if not job then
            return
        end
        if not job.part then
            if now - job.t0 > 1.5 then
                aim.job = nil
                return
            end
            local p = pickPart(job, now)
            if not p then
                return
            end
            job.part = p
            job.firstT = now
            usedParts[p] = true
            table.insert(job.samples, { t = 0, pos = p.Position })
            return
        end
        local p = job.part
        if not p.Parent then
            aim.job = nil
            finishJob(job, now)
            return
        end
        local pos = p.Position
        local last = job.samples[#job.samples]
        if (pos - last.pos).Magnitude > 0.001 then
            table.insert(job.samples, { t = now - job.firstT, pos = pos })
        end
        if now - job.firstT >= V.STEER_DELAY then
            aim.job = nil
            finishJob(job, now)
        end
    end

    local function stopSteer()
        aim.steer = nil
    end

    local function stepSteer(now, dt)
        local st = aim.steer
        if not st then
            return
        end
        local p, root = st.part, st.root
        if not (p and p.Parent and root and root.Parent) then
            stopSteer()
            return
        end
        if now - st.t0 > V.STEER_MAX_TIME then
            stopSteer()
            return
        end
        local pos = p.Position
        local dist = (root.Position - pos).Magnitude
        if dist <= V.STEER_STOP_DIST then
            stopSteer()
            return
        end
        local hv = Vector3.new(0, 0, 0)
        local tr = tracker[root]
        if tr then
            hv = Vector3.new(tr.vel.X, 0, tr.vel.Z)
            if hv.Magnitude < 1.0 then
                local ok, av = pcall(function()
                    return root.AssemblyLinearVelocity
                end)
                if ok and typeof(av) == "Vector3" then
                    local avH = Vector3.new(av.X, 0, av.Z)
                    hv = avH:Lerp(hv, 0.3)
                end
            end
            if hv.Magnitude > V.MAX_PREDICT_SPEED then
                hv = hv.Unit * V.MAX_PREDICT_SPEED
            end
        end
        local anchored = p.Anchored
        local cur = nil
        local sp = st.speed
        if not anchored then
            cur = p.AssemblyLinearVelocity
            sp = cur.Magnitude
            if sp < st.minSpeed then
                st.slow = st.slow + dt
                if st.slow > 0.25 then
                    stopSteer()
                end
                return
            end
            st.slow = 0
        end
        local lead = ping * V.LEAD_PING_MULT + V.EXTRA_LEAD
        local aimPos = root.Position + Vector3.new(0, V.AIM_OFFSET_Y, 0) + hv * (dist / math.max(sp, 1) + lead)
        local want = aimPos - pos
        if want.Magnitude < 0.001 then
            return
        end
        want = want.Unit
        local newDir = want
        if cur then
            local curDir = cur.Unit
            local ang = math.acos(math.clamp(curDir:Dot(want), -1, 1))
            local maxTurn = V.STEER_TURN_RATE * dt
            if dist > V.STEER_NEAR_DIST and ang > maxTurn and ang > 0 then
                local mix = curDir:Lerp(want, maxTurn / ang)
                if mix.Magnitude > 0.001 then
                    newDir = mix.Unit
                end
            end
        end
        if anchored then
            local step = math.min(sp * dt, dist)
            local np = pos + newDir * step
            p.CFrame = CFrame.new(np, np + newDir)
        else
            p.AssemblyLinearVelocity = newDir * sp
        end
    end

    local function refreshTargets(now)
        local cam = workspace.CurrentCamera
        if not cam then
            aim.target = nil
            return
        end
        local fov = Hub.State.VeilFov
        local camCF = cam.CFrame
        local camPos = camCF.Position
        local look = camCF.LookVector
        local list = {}
        local best, bestAngle = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 and not FX.isKillerChar(char, now) then
                        if not p:GetAttribute("IsDead") and not char:GetAttribute("IsCarried") and not char:GetAttribute("IsHooked") then
                            local v = root.Position - camPos
                            local dist = v.Magnitude
                            if dist > 0.5 and dist <= V.MAX_TARGET_DISTANCE then
                                local dot = look:Dot(v / dist)
                                local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                                local vel = trackVelocity(root, now)
                                local hv = Vector3.new(vel.X, 0, vel.Z)
                                if hv.Magnitude < 1.0 then
                                    local av = root.AssemblyLinearVelocity
                                    local avH = Vector3.new(av.X, 0, av.Z)
                                    hv = avH:Lerp(hv, 0.3)
                                end
                                if hv.Magnitude > V.MAX_PREDICT_SPEED then
                                    hv = hv.Unit * V.MAX_PREDICT_SPEED
                                end
                                local entry = {
                                    root = root,
                                    name = p.Name,
                                    dist = dist,
                                    angle = angle,
                                    hv = hv,
                                }
                                table.insert(list, entry)
                                if angle <= fov and angle < bestAngle then
                                    bestAngle = angle
                                    best = entry
                                end
                            end
                        end
                    end
                end
            end
        end
        local prevRoot = aim.prevRoot
        if best and prevRoot and best.root ~= prevRoot then
            for i = 1, #list do
                local e = list[i]
                if e.root == prevRoot and e.angle <= fov and (e.angle - bestAngle) < V.TARGET_HYSTERESIS then
                    best = e
                    break
                end
            end
        end
        if best then
            aim.target = best
            aim.prevRoot = best.root
            aim.updatedAt = now
        else
            aim.target = nil
        end
    end

    local function ensureLabel()
        if label and label.Parent then
            return label
        end
        local parent = Hub.Overlay
        if not parent then
            return nil
        end
        label = Instance.new("TextLabel")
        label.Name = "VeilTargetLabel"
        label.AnchorPoint = Vector2.new(0.5, 1)
        label.Size = UDim2.fromOffset(160, 24)
        label.BackgroundTransparency = 1
        label.BorderSizePixel = 0
        label.Text = V.LABEL_TEXT
        label.TextColor3 = Hub.Colors.VisualTarget
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.2
        label.Font = Enum.Font.GothamBold
        label.TextSize = V.LABEL_SIZE
        label.Visible = false
        label.Active = false
        label.ZIndex = 50
        label.Parent = parent
        return label
    end

    local function updateTargetLabel()
        local t = aim.target
        local cam = workspace.CurrentCamera
        if Hub.State.VeilTarget and t and t.root and t.root.Parent and cam then
            local lab = ensureLabel()
            if lab then
                local head = t.root.Parent:FindFirstChild("Head")
                local worldPos
                if head and head:IsA("BasePart") then
                    worldPos = head.Position + Vector3.new(0, V.LABEL_HEAD_OFFSET, 0)
                else
                    worldPos = t.root.Position + Vector3.new(0, 4.5, 0)
                end
                local pos = cam:WorldToViewportPoint(worldPos)
                if pos.Z > 0 then
                    lab.TextColor3 = Hub.Colors.VisualTarget
                    lab.Position = UDim2.fromOffset(pos.X, pos.Y)
                    lab.Visible = true
                    return
                end
            end
        end
        if label then
            label.Visible = false
        end
    end

    local function start()
        if active then
            return
        end
        active = true
        findRemotes()
        if not FX.installHook() then
            if Hub.Notify then
                Hub.Notify("Hook tidak tersedia, Silent Aim Veil tidak jalan")
            end
        end
        handlerFn = FX.addHandler(onFire)
        table.insert(conns, workspace.DescendantAdded:Connect(function(inst)
            local now = os.clock()
            if now > aim.armedUntil then
                return
            end
            if inst:IsA("BasePart") then
                table.insert(recent, { part = inst, t = now })
                if #recent > 200 then
                    table.remove(recent, 1)
                end
            end
        end))
        local lastPingT, lastRemoteT = 0, 0
        table.insert(conns, RunService.Heartbeat:Connect(function(dt)
            if not active then
                return
            end
            local now = os.clock()
            if now - lastPingT >= 0.5 then
                lastPingT = now
                refreshPing()
            end
            if now - lastRemoteT >= 1 then
                lastRemoteT = now
                if not (spearRemote and spearRemote.Parent) or not (vfxRemote and vfxRemote.Parent) then
                    findRemotes()
                end
            end
            if aim.holding then
                aim.armedUntil = now + 2
            end
            pcall(refreshTargets, now)
            local okJ = pcall(stepJob, now)
            if not okJ then
                aim.job = nil
            end
            local okS = pcall(stepSteer, now, dt)
            if not okS then
                stopSteer()
            end
            pcall(updateTargetLabel)
        end))
    end

    local function stop()
        if not active then
            return
        end
        active = false
        if handlerFn then
            FX.removeHandler(handlerFn)
            handlerFn = nil
        end
        FX.disconnectAll(conns)
        aim.target = nil
        aim.prevRoot = nil
        aim.job = nil
        aim.steer = nil
        aim.holding = false
        aim.thrownRoot = nil
        aim.thrownName = nil
        recent = {}
        if label then
            pcall(function()
                label:Destroy()
            end)
            label = nil
        end
    end

    Hub.OnChange("SilentAimVeil", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local TOOL_NAME = "Twist of Fate"
    local PROJECTILE_SPEED = 260
    local PREDICT_BIAS = 0.15
    local HIT_WINDOW = 1.2
    local HIT_WORDS = { "stun", "hit", "damage", "hurt", "dizzy", "blind", "stagger", "slow" }

    local active = false
    local token = 0
    local conns = {}
    local handlerFn = nil
    local fireRemote = nil
    local targetBody = nil
    local myRootRef = nil
    local velTracker = setmetatable({}, { __mode = "k" })
    local healthSeen = setmetatable({}, { __mode = "k" })
    local watched = setmetatable({}, { __mode = "k" })
    local lastShotT = -math.huge
    local shotHandled = true

    local function findFire()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local items = remotes and remotes:FindFirstChild("Items")
        local folder = items and items:FindFirstChild(TOOL_NAME)
        local fr = folder and folder:FindFirstChild("Fire")
        if fr then
            fireRemote = fr
        end
    end

    local function updateVelocity(body)
        local now = os.clock()
        local prev = velTracker[body]
        local curPos = body.Position
        if prev then
            local dt = now - prev.t
            if dt > 0.001 then
                local vel = (curPos - prev.pos) / dt
                if dt > 0.5 or vel.Magnitude > 200 then
                    vel = Vector3.new(0, 0, 0)
                end
                velTracker[body] = { pos = curPos, t = now, vel = vel }
                return vel
            end
            return prev.vel or Vector3.new(0, 0, 0)
        end
        velTracker[body] = { pos = curPos, t = now, vel = Vector3.new(0, 0, 0) }
        return Vector3.new(0, 0, 0)
    end

    local function predictPosition(fromPos, body)
        local targetPos = body.Position
        local tr = velTracker[body]
        local vel = (tr and tr.vel) or Vector3.new(0, 0, 0)
        local dist = (targetPos - fromPos).Magnitude
        local tFlight = dist / PROJECTILE_SPEED
        for _ = 1, 2 do
            local predicted = targetPos + vel * (tFlight + PREDICT_BIAS)
            dist = (predicted - fromPos).Magnitude
            tFlight = dist / PROJECTILE_SPEED
        end
        local finalPos = targetPos + vel * (tFlight + PREDICT_BIAS)
        local offset = finalPos - targetPos
        if offset.Magnitude > 3.5 then
            finalPos = targetPos + offset.Unit * 3.5
        end
        return finalPos
    end

    local function getKillerBody(character)
        if not character then
            return nil
        end
        local body = character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("LowerTorso")
        if body then
            return body
        end
        return character:FindFirstChild("HumanoidRootPart")
    end

    local function getKiller()
        local myChar = player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then
            return nil
        end
        local now = os.clock()
        local nearestBody = nil
        local nearestDistance = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                if char and FX.isKillerChar(char, now) then
                    local body = getKillerBody(char)
                    if body then
                        local distance = (body.Position - myHRP.Position).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            nearestBody = body
                        end
                    end
                end
            end
        end
        return nearestBody
    end

    local function refreshTarget()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        myRootRef = root
        if root then
            local body = getKiller()
            targetBody = body
            if body then
                updateVelocity(body)
            end
        else
            targetBody = nil
        end
    end

    local function silentDirection()
        local body = targetBody
        local root = myRootRef
        if not body or not root then
            return nil
        end
        if body.Parent == nil or root.Parent == nil then
            return nil
        end
        local fromPos = root.Position
        local predictedPos = predictPosition(fromPos, body)
        local d = predictedPos - fromPos
        local m = d.Magnitude
        if m < 0.001 then
            return nil
        end
        return d / m
    end

    local function registerHit(now)
        if shotHandled then
            return
        end
        if now - lastShotT > HIT_WINDOW then
            return
        end
        shotHandled = true
        if Hub.PlayHit then
            Hub.PlayHit()
        end
    end

    local function nameMatches(name)
        local lower = string.lower(tostring(name))
        for _, w in ipairs(HIT_WORDS) do
            if string.find(lower, w, 1, true) then
                return true
            end
        end
        return false
    end

    local function truthy(v)
        if v == true then
            return true
        end
        if type(v) == "number" then
            return v ~= 0
        end
        if type(v) == "string" then
            return v ~= ""
        end
        return false
    end

    local function watchKiller(char)
        if watched[char] then
            return
        end
        watched[char] = true
        table.insert(conns, char.AttributeChanged:Connect(function(name)
            if nameMatches(name) and truthy(char:GetAttribute(name)) then
                registerHit(os.clock())
            end
        end))
        table.insert(conns, char.ChildAdded:Connect(function(child)
            if nameMatches(child.Name) then
                registerHit(os.clock())
            end
        end))
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            table.insert(conns, hum.AttributeChanged:Connect(function(name)
                if nameMatches(name) and truthy(hum:GetAttribute(name)) then
                    registerHit(os.clock())
                end
            end))
        end
    end

    local function checkHits(now)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                if char and FX.isKillerChar(char, now) then
                    watchKiller(char)
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local prev = healthSeen[hum]
                        local cur = hum.Health
                        if prev and cur < prev - 0.01 then
                            registerHit(now)
                        end
                        healthSeen[hum] = cur
                    end
                end
            end
        end
    end

    local function onFire(self, ...)
        if fireRemote and self == fireRemote then
            lastShotT = os.clock()
            shotHandled = false
            local gun, dir = ...
            if typeof(gun) == "Instance" and typeof(dir) == "Vector3" then
                local ok, newDir = pcall(silentDirection)
                if ok and typeof(newDir) == "Vector3" then
                    local args = table.pack(...)
                    args[2] = newDir
                    return args
                end
            end
        end
        return nil
    end

    local function start()
        if active then
            return
        end
        active = true
        token = token + 1
        local my = token
        shotHandled = true
        findFire()
        if not FX.installHook() then
            if Hub.Notify then
                Hub.Notify("Hook tidak tersedia, Silent Aim TOF tidak jalan")
            end
        end
        handlerFn = FX.addHandler(onFire)
        task.spawn(function()
            local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
            local items = remotes and remotes:WaitForChild("Items", 30)
            local folder = items and items:WaitForChild(TOOL_NAME, 30)
            local fr = folder and folder:WaitForChild("Fire", 30)
            if fr and active and token == my then
                fireRemote = fr
            end
        end)
        task.spawn(function()
            local lastFindT = 0
            while active and token == my do
                pcall(refreshTarget)
                local now = os.clock()
                if now - lastFindT >= 1 then
                    lastFindT = now
                    if not (fireRemote and fireRemote.Parent) then
                        pcall(findFire)
                    end
                end
                task.wait(0.1)
            end
        end)
        table.insert(conns, RunService.Heartbeat:Connect(function()
            if not active then
                return
            end
            pcall(checkHits, os.clock())
        end))
        table.insert(conns, player.CharacterAdded:Connect(function()
            velTracker = setmetatable({}, { __mode = "k" })
        end))
    end

    local function stop()
        if not active then
            return
        end
        active = false
        token = token + 1
        if handlerFn then
            FX.removeHandler(handlerFn)
            handlerFn = nil
        end
        FX.disconnectAll(conns)
        watched = setmetatable({}, { __mode = "k" })
        targetBody = nil
        myRootRef = nil
        shotHandled = true
    end

    Hub.OnChange("SilentAimTOF", function(on)
        if on then
            start()
        else
            stop()
        end
    end)
end

