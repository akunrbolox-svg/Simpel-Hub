local function floaterCount()
    local n = 0
    for _ in pairs(floaters) do
        n = n + 1
    end
    return n
end

local function destroyFloater(key)
    local f = floaters[key]
    if not f then
        return
    end
    unregister(key, f.refresh)
    movers[f.mover] = nil
    if currentDrag and currentDrag.m == f.mover then
        currentDrag = nil
    end
    pcall(function()
        f.frame:Destroy()
    end)
    floaters[key] = nil
end

local function createFloater(key, label, fx, fy)
    if floaters[key] then
        return
    end
    local f = create("Frame", {
        Name = "Floater_" .. key,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(104, 46),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 3,
    }, screenGui)
    corner(f, 10)
    local st = stroke(f, OFF_COLOR, 0.1, 1.5)
